// CertifiedPass — Prisma Schema
// Database: PostgreSQL
//
// Privacy rules (§11):
//   - credentials table: NO PII — only hashes, addresses, types, URIs, timestamps
//   - users / issuers: PII allowed (display name, bio, website) — access-controlled
//   - credential_metadata (JSON field) contains off-chain fields — NOT on-chain
//
// State machine:
//   Credential.status: draft → approved → issued → active → revoked
//   Revoked is terminal — enforced at application AND contract level.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Users
// =============================================================================

model User {
  id            String   @id @default(uuid())
  walletAddress String   @unique @map("wallet_address") // EVM checksum address
  username      String?  @unique
  displayName   String?  @map("display_name")
  bio           String?
  avatarUrl     String?  @map("avatar_url")
  isAdmin       Boolean  @default(false) @map("is_admin")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  receivedCredentials Credential[] @relation("HolderCredentials")

  @@map("users")
}

// =============================================================================
// Issuers
// =============================================================================

model Issuer {
  id                 String                   @id @default(uuid())
  walletAddress      String                   @unique @map("wallet_address")
  name               String
  description        String?
  website            String?
  logoUrl            String?                  @map("logo_url")
  verificationStatus IssuerVerificationStatus @default(PENDING) @map("verification_status")

  // Social links (stored as JSON for flexibility)
  socialLinks Json? @map("social_links")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  events             IssuerEvent[]
  issuedCredentials  Credential[] @relation("IssuerCredentials")
  revocations        Revocation[]
  aiExtractionJobs   AiExtractionJob[]

  @@map("issuers")
}

enum IssuerVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("issuer_verification_status")
}

// =============================================================================
// Events / Programs
// =============================================================================

model IssuerEvent {
  id          String  @id @default(uuid())
  issuerId    String  @map("issuer_id")
  name        String
  eventType   String  @map("event_type") // Matches CredentialType
  description String?
  date        DateTime?
  location    String?
  isActive    Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  issuer      Issuer       @relation(fields: [issuerId], references: [id], onDelete: Cascade)
  credentials Credential[]

  @@map("issuer_events")
}

// =============================================================================
// Credentials
// =============================================================================

model Credential {
  id             String           @id @default(uuid())
  issuerId       String           @map("issuer_id")
  holderAddress  String           @map("holder_address") // EVM address — NOT wallet FK to protect privacy
  eventId        String?          @map("event_id")

  // Credential classification
  credentialType CredentialType   @map("credential_type")
  status         CredentialStatus @default(DRAFT)

  // On-chain anchoring fields
  credentialHash String?  @map("credential_hash") // SHA-256 hex, populated when issued
  metadataUri    String?  @map("metadata_uri")    // Points to JSON (DB or IPFS)
  txHash         String?  @map("tx_hash")          // Blockchain transaction hash
  chainId        Int?     @map("chain_id")         // EVM chain ID
  blockNumber    BigInt?  @map("block_number")

  // Off-chain metadata — the full credential fields
  // NEVER synced to on-chain directly; only the hash goes on-chain
  metadata       Json     // Stores the CredentialMetadata object

  // Timestamps
  issuedAt    DateTime? @map("issued_at")  // When blockchain tx was confirmed
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt      @map("updated_at")

  // Relations
  issuer     Issuer       @relation("IssuerCredentials", fields: [issuerId], references: [id])
  holder     User?        @relation("HolderCredentials", fields: [holderAddress], references: [walletAddress])
  event      IssuerEvent? @relation(fields: [eventId], references: [id])
  revocation Revocation?

  @@index([holderAddress])
  @@index([issuerId])
  @@index([credentialHash])
  @@index([status])
  @@map("credentials")
}

enum CredentialType {
  HACKATHON
  INTERNSHIP
  OPENSOURCE
  EVENT
  WORKSHOP
  COMPETITION

  @@map("credential_type")
}

enum CredentialStatus {
  DRAFT
  APPROVED
  ISSUED
  ACTIVE
  REVOKED

  @@map("credential_status")
}

// =============================================================================
// Revocations
// =============================================================================

model Revocation {
  id           String    @id @default(uuid())
  credentialId String    @unique @map("credential_id") // One revocation per credential
  issuerId     String    @map("issuer_id")
  reason       String
  txHash       String?   @map("tx_hash") // Blockchain transaction hash for revocation
  revokedAt    DateTime  @default(now()) @map("revoked_at")

  // Relations
  credential Credential @relation(fields: [credentialId], references: [id])
  issuer     Issuer     @relation(fields: [issuerId], references: [id])

  @@map("revocations")
}

// =============================================================================
// Auth Nonces
// =============================================================================

model AuthNonce {
  id            String   @id @default(uuid())
  walletAddress String   @map("wallet_address")
  nonce         String   @unique
  message       String   // The full message the wallet signed
  usedAt        DateTime? @map("used_at")  // Null = unused, non-null = consumed
  expiresAt     DateTime  @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([walletAddress])
  @@index([expiresAt])
  @@map("auth_nonces")
}

// =============================================================================
// AI Extraction Jobs
// =============================================================================

model AiExtractionJob {
  id             String              @id @default(uuid())
  issuerId       String              @map("issuer_id")
  status         AiExtractionStatus  @default(PENDING)
  credentialTypeHint CredentialType? @map("credential_type_hint")

  // Input
  inputFileName  String?  @map("input_file_name")
  inputMimeType  String?  @map("input_mime_type")
  inputSizeBytes Int?     @map("input_size_bytes")

  // Output — stored as JSON
  rawOutput        Json?    @map("raw_output")        // AI's raw response (for debugging)
  validatedDrafts  Json?    @map("validated_drafts")  // Validated CredentialDraft[]
  totalExtracted   Int?     @map("total_extracted")
  totalFailed      Int?     @map("total_failed")

  // Cost tracking
  tokensUsed     Int?     @map("tokens_used")

  // Error info
  errorMessage   String?  @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt      @map("updated_at")

  // Relations
  issuer Issuer @relation(fields: [issuerId], references: [id])

  @@index([issuerId])
  @@index([status])
  @@map("ai_extraction_jobs")
}

enum AiExtractionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED

  @@map("ai_extraction_status")
}
