# =============================================================================
# CertifiedPass — Environment Variables Template
# Copy to .env and fill in all values before running locally.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection URL for Prisma
DATABASE_URL="postgresql://certifiedpass:password@localhost:5432/certifiedpass_dev"

# PolyLance Sovereign Partner Audit Database
POLYLANCE_DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Redis connection URL (for job queues and rate limiting)
REDIS_URL="redis://localhost:6379"

# -----------------------------------------------------------------------------
# AUTHENTICATION
# -----------------------------------------------------------------------------
# Secret used to sign JWT tokens — must be long, random, and unique per env
JWT_SECRET="change-me-to-a-long-random-secret-string"

# JWT token expiry (e.g. 7d, 24h, 1h)
JWT_EXPIRES_IN="7d"

# Nonce expiry in seconds (for wallet signature auth)
NONCE_EXPIRES_IN=300

# -----------------------------------------------------------------------------
# BLOCKCHAIN — Polygon Amoy Testnet (MVP default)
# Change to mainnet values for production
# -----------------------------------------------------------------------------
# Chain ID: Polygon Amoy = 80002
CHAIN_ID=80002

# Public RPC endpoint (can use Alchemy / Infura / QuickNode in production)
RPC_URL="https://rpc-amoy.polygon.technology"

# Block explorer base URL for tx hash links
EXPLORER_URL="https://www.oklink.com/amoy"

# Deployed CertifiedPassRegistry contract address (set after deployment)
CONTRACT_ADDRESS=""

# Private key of the deployer/admin wallet (NEVER commit this)
# Only used server-side for admin transactions — never expose to frontend
DEPLOYER_PRIVATE_KEY=""

# Optional: Polygon scan API key for contract verification
POLYGONSCAN_API_KEY=""

# -----------------------------------------------------------------------------
# AI — Google Gemini (default: gemini-1.5-flash)
# -----------------------------------------------------------------------------
GOOGLE_AI_API_KEY=""

# Model name — gemini-1.5-flash for cost-effective bulk extraction
GEMINI_MODEL="gemini-1.5-flash"

# Max tokens for extraction responses
GEMINI_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# FILE STORAGE
# -----------------------------------------------------------------------------
# Local upload directory (dev only; use cloud storage in production)
UPLOAD_DIR="./uploads"

# Max upload size in bytes (default: 10MB)
MAX_UPLOAD_SIZE=10485760

# Allowed MIME types (comma-separated)
ALLOWED_MIME_TYPES="application/pdf,image/jpeg,image/png,image/webp,text/csv,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"

# Pinata IPFS (optional — for metadata URI storage in production)
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
PINATA_GATEWAY_URL="https://gateway.pinata.cloud"

# -----------------------------------------------------------------------------
# API SERVER
# -----------------------------------------------------------------------------
# Port for the Express API server
PORT=3001

# Node environment
NODE_ENV="development"

# CORS — allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# Base URL of the API server (used to generate credential URLs, QR codes)
API_BASE_URL="http://localhost:3001"

# Base URL of the web frontend (used to generate public credential links)
APP_BASE_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Max requests per IP per window (15 minutes default)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Stricter limits for AI extraction endpoint
AI_RATE_LIMIT_WINDOW_MS=3600000
AI_RATE_LIMIT_MAX_REQUESTS=20

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL="info"

# Log format: json (production) | pretty (development)
LOG_FORMAT="pretty"

# -----------------------------------------------------------------------------
# ADMIN
# -----------------------------------------------------------------------------
# Admin wallet address — the only address that can grant issuer verification
ADMIN_WALLET_ADDRESS=""

# Admin API key for internal management endpoints (long random string)
ADMIN_API_KEY=""

# -----------------------------------------------------------------------------
# OPTIONAL — Email notifications (future)
# -----------------------------------------------------------------------------
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# FROM_EMAIL="noreply@certifiedpass.io"
